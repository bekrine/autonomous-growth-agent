NODE_ENV=development

# --- API ---
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_growth

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3

# --- Instagram ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Object storage (media) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Safety ---
AUTONOMY_KILL_SWITCH=false
