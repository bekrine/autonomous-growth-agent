NODE_ENV=development

# --- API ---
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_growth

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- LLM ---
# Leave every key blank to run fully on mock providers (no cost, deterministic).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3

# --- Hugging Face (free tier; takes priority over OPENAI_API_KEY when set) ---
# Token: https://huggingface.co/settings/tokens (needs "Inference Providers" permission)
HF_TOKEN=
HF_TEXT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Real image generation is NOT free on Hugging Face (their own hf-inference
# provider no longer serves text-to-image), so it is opt-in. Left false, the
# pipeline uses MockImageGenerator: fully working, zero cost, clearly labeled.
IMAGE_GENERATION_ENABLED=false
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=fal-ai

# --- Content generation (Phase 3) ---
MAX_CONTENT_GENERATION_ATTEMPTS=3
MAX_DAILY_MEDIA_GENERATIONS=50

# --- Instagram (Phase 4 — see docs/instagram-setup.md) ---
# Meta app credentials. Requires an Instagram Professional account linked to a
# Facebook Page. Leave blank and the app still boots; Instagram endpoints return
# 503 INSTAGRAM_NOT_CONFIGURED.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/social/instagram/callback
META_API_VERSION=v21.0
META_GRAPH_HOST=https://graph.facebook.com

# Encrypts access tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable — changing it makes every stored token unreadable.
TOKEN_ENCRYPTION_KEY=

# Master switch for real Meta API calls. Off = a mock publisher is used.
# NEVER enable in CI.
INSTAGRAM_PUBLISHING_ENABLED=false

# --- Publishing safety ---
# Off = agents cannot publish; only human-initiated publishes are allowed.
AUTO_PUBLISH_ENABLED=false
MAX_POSTS_PER_DAY=5
MAX_POSTS_PER_HOUR=2
MIN_MINUTES_BETWEEN_POSTS=10
MAX_PUBLISH_ATTEMPTS=3

# Where the OAuth callback sends the operator back to.
DASHBOARD_URL=http://localhost:3000

# Legacy Phase 1 placeholders, unused by Phase 4.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Object storage (media) ---
# Local-disk fallback, used when R2 below is not fully configured. Assets are
# written to STORAGE_LOCAL_DIR and served by the API at PUBLIC_MEDIA_BASE_URL.
# NOTE: a localhost URL is NOT reachable by Meta — real publishing needs R2.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media

# --- Cloudflare R2 (media storage — see docs/storage.md) ---
# Server-side secrets. Never commit these, never send them to the browser.
# R2 is selected only when ALL of ACCOUNT_ID/ACCESS_KEY_ID/SECRET/BUCKET/PUBLIC_BASE_URL
# are set; a partial config falls back to local disk rather than producing
# URLs Meta cannot fetch.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=autonomous-growth-media
# Cloudflare bucket -> Settings -> Public Development URL (https://pub-<hash>.r2.dev).
# This is public by design: it is what lets Meta fetch generated media.
R2_PUBLIC_BASE_URL=
# Opt-in switch for the test that hits the real bucket. NEVER enable in CI.
R2_INTEGRATION_TEST=false

# --- Safety ---
AUTONOMY_KILL_SWITCH=false
