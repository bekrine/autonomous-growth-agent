NODE_ENV=development

# --- API ---
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_growth

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- LLM ---
# Leave every key blank to run fully on mock providers (no cost, deterministic).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3

# --- Hugging Face (free tier; takes priority over OPENAI_API_KEY when set) ---
# Token: https://huggingface.co/settings/tokens (needs "Inference Providers" permission)
HF_TOKEN=
HF_TEXT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Real image generation is NOT free on Hugging Face (their own hf-inference
# provider no longer serves text-to-image), so it is opt-in. Left false, the
# pipeline uses MockImageGenerator: fully working, zero cost, clearly labeled.
IMAGE_GENERATION_ENABLED=false
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=fal-ai

# --- Content generation (Phase 3) ---
MAX_CONTENT_GENERATION_ATTEMPTS=3
MAX_DAILY_MEDIA_GENERATIONS=50

# --- Instagram ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Object storage (media) ---
# STORAGE_* are reserved for a future S3/R2 provider; today generated assets
# are written to STORAGE_LOCAL_DIR and served by the API at PUBLIC_MEDIA_BASE_URL.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media

# --- Safety ---
AUTONOMY_KILL_SWITCH=false
